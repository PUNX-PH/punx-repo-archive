rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same gate as Firestore: verified @punx.ai Google accounts only.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@punx[.]ai')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // files/{owner}/{fileId}/{name}. Reading follows the file's sharing in Firestore (owner, anyone at punx.ai,
    // or the emails it is shared with). Only the owner can add or remove their own files (50 MB max).
    // Files are never edited in place, so there is no update rule.
    match /files/{uid}/{fileId}/{name} {
      function shareDoc() {
        return firestore.get(/databases/(default)/documents/files/$(fileId)).data;
      }

      allow read: if isMember()
        && (request.auth.uid == uid
          || shareDoc().get('domain', false) == true
          || request.auth.token.email.lower() in shareDoc().get('viewers', []));
      allow create: if isMember()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isMember() && request.auth.uid == uid;
    }
  }
}
