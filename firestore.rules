rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in, verified @punx.ai Google accounts can touch anything.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@punx[.]ai')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // --- Sharing helpers for the file archive ---
    function validList(d, k) {
      return !(k in d) || (d[k] is list && d[k].size() <= 100);
    }
    function sharingOk(d) {
      return validList(d, 'viewers') && validList(d, 'editors') && validList(d, 'people')
        && (!('domain' in d) || d.domain is bool)
        && (!('access' in d) || d.access in ['restricted', 'domain', 'public'])
        && publicOk(d);
    }
    // 'public' makes an HTML page readable with no sign-in (see the get rule on files). Only HTML files may be public.
    function publicOk(d) {
      return !('public' in d)
        || (d.public is bool
          && (d.public == false
            || (d.get('name', '') is string && d.get('name', '').lower().matches('.*[.](html|htm|xhtml|mhtml)')))
          && (!('access' in d) || d.public == (d.access == 'public')));
    }
    function folderPath(fid) {
      return /databases/$(database)/documents/fileFolders/$(fid);
    }
    // Folders made before sharing existed have 'createdBy' instead of 'ownerUid'.
    function folderOwner(f) {
      return f.get('ownerUid', f.get('createdBy', ''));
    }
    function canEditFolder(fid) {
      return fid == ''
        || (exists(folderPath(fid))
          && (folderOwner(get(folderPath(fid)).data) == request.auth.uid
            || myEmail() in get(folderPath(fid)).data.get('editors', [])));
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function nameOk(max) {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= max;
    }

    // Each member can only read and write their own bookmarks and folders.
    match /users/{uid}/bookmarks/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
    match /users/{uid}/folders/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Shared folders someone opened, so they can find them again.
    match /users/{uid}/sharedWithMe/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Shared folders: any member with the link can read one share by id, but nobody can
    // list or search them except their owner. Only the owner can create, change or remove a share.
    match /shares/{id} {
      allow get: if isMember();
      allow list: if isMember() && resource.data.ownerUid == request.auth.uid;
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.repos.size() <= 200;
      allow update: if isMember()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.repos.size() <= 200;
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;
    }

    // Archived files are private to their owner until shared, like Google Drive.
    // 'domain' (anyone at punx.ai) and 'viewers' / 'editors' (emails) are the effective access: the file's own
    // sharing plus its folder's. Each person's queries match one of: owner, domain, or their email in viewers.
    //   Owner: everything (share, move, rename, delete).   Editor: rename.
    //   Folder owner: can refresh the access fields (and un-file) on files inside their folder.
    match /files/{id} {
      // One document by id, for anyone, but only when the owner made the HTML page public. Not listable, so
      // public pages can't be enumerated. The /p/<id> route and Storage use this to serve the page with no sign-in.
      allow get: if resource.data.get('public', false) == true;

      allow read: if isMember()
        && (resource.data.uploaderUid == request.auth.uid
          || resource.data.domain == true
          || myEmail() in resource.data.viewers);

      allow create: if isMember()
        && request.resource.data.uploaderUid == request.auth.uid
        && nameOk(120)
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 52428800
        && sharingOk(request.resource.data)
        && (!('folderId' in request.resource.data)
          || (request.resource.data.folderId is string && canEditFolder(request.resource.data.folderId)));

      allow update: if isMember()
        && sharingOk(request.resource.data)
        && (
          (resource.data.uploaderUid == request.auth.uid
            && changed().hasOnly(['name', 'folderId', 'folder', 'access', 'people', 'public', 'domain', 'viewers', 'editors', 'uploaderEmail'])
            && nameOk(120)
            && (!changed().hasAny(['folderId'])
              || (request.resource.data.folderId is string && canEditFolder(request.resource.data.folderId))))
          || (myEmail() in resource.data.get('editors', [])
            && changed().hasOnly(['name'])
            && nameOk(120))
          || (resource.data.get('folderId', '') != ''
            && exists(folderPath(resource.data.folderId))
            && folderOwner(get(folderPath(resource.data.folderId)).data) == request.auth.uid
            && changed().hasOnly(['domain', 'viewers', 'editors', 'folderId'])
            && request.resource.data.get('folderId', '') in ['', resource.data.folderId])
        );

      allow delete: if isMember() && resource.data.uploaderUid == request.auth.uid;
    }

    // Folders for the file archive, shared the same way. Only the owner can rename, share or delete one.
    match /fileFolders/{id} {
      allow read: if isMember()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || resource.data.domain == true
          || myEmail() in resource.data.viewers);

      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && nameOk(40)
        && sharingOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'ownerEmail', 'createdAt', 'createdBy', 'access', 'people', 'domain', 'viewers', 'editors']);

      allow update: if isMember()
        && folderOwner(resource.data) == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && nameOk(40)
        && sharingOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'ownerEmail', 'createdAt', 'createdBy', 'access', 'people', 'domain', 'viewers', 'editors']);

      allow delete: if isMember() && folderOwner(resource.data) == request.auth.uid;
    }

    // View counters. Any member can add exactly one view at a time and nothing else.
    match /stats/{id} {
      allow get: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == 1;
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }
  }
}
