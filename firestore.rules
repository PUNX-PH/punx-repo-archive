rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in, verified @punx.ai Google accounts can touch anything.
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@punx[.]ai')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Each member can only read and write their own bookmarks and folders.
    match /users/{uid}/bookmarks/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
    match /users/{uid}/folders/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Shared folders someone opened, so they can find them again.
    match /users/{uid}/sharedWithMe/{id} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Shared folders: any member with the link can read one share by id, but nobody can
    // list or search them except their owner. Only the owner can create, change or remove a share.
    match /shares/{id} {
      allow get: if isMember();
      allow list: if isMember() && resource.data.ownerUid == request.auth.uid;
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.repos.size() <= 200;
      allow update: if isMember()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.repos.size() <= 200;
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;
    }

    // Archived files: the whole team can see the list. Anyone can add one under their own name (50 MB max);
    // only the uploader can rename (the name is the only field that may change) or remove it.
    match /files/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 52428800;
      allow update: if isMember()
        && resource.data.uploaderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if isMember() && resource.data.uploaderUid == request.auth.uid;
    }

    // View counters. Any member can add exactly one view at a time and nothing else.
    match /stats/{id} {
      allow get: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == 1;
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }
  }
}
