# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Powers the "Ask" box; without it Ask falls back to plain GitHub search.
ANTHROPIC_API_KEY=

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
